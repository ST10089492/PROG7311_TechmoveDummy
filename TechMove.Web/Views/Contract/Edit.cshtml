@model TechMove.Web.Models.Contract
@{ ViewData["Title"] = "Edit Contract"; }

<h2>Edit Contract</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="SignedAgreementPath" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="ClientId" class="form-label"></label>
                <select asp-for="ClientId" asp-items="ViewBag.Clients" class="form-select"></select>
            </div>
            <div class="mb-3">
                <label asp-for="ServiceLevel" class="form-label"></label>
                <select asp-for="ServiceLevel" asp-items="ViewBag.ServiceLevels" class="form-select"></select>
            </div>
            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="ViewBag.Statuses" class="form-select"></select>
            </div>
            <div class="row">
                <div class="col mb-3">
                    <label asp-for="StartDate" class="form-label"></label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                </div>
                <div class="col mb-3">
                    <label asp-for="EndDate" class="form-label"></label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                </div>
            </div>
            <div class="mb-3">
                <label for="signedAgreement" class="form-label">Replace Signed Agreement (PDF only)</label>
                @if (!string.IsNullOrEmpty(Model.SignedAgreementPath))
                {
                    <p class="text-muted small">Current: <a href="@Model.SignedAgreementPath" target="_blank">View</a></p>
                }
                <input type="file" name="signedAgreement" id="signedAgreement" accept=".pdf" class="form-control" />
            </div>
            <button type="submit" class="btn btn-warning">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
