@model IEnumerable<TechMove.Web.Models.Contract>
@{ ViewData["Title"] = "Contracts"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Contracts</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Contract</a>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-3">
        <input type="date" name="from" value="@ViewBag.From" class="form-control" placeholder="Start from" />
    </div>
    <div class="col-md-3">
        <input type="date" name="to" value="@ViewBag.To" class="form-control" placeholder="End to" />
    </div>
    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">All Statuses</option>
            @foreach (var s in Enum.GetValues<TechMove.Web.Models.ContractStatus>())
            {
                <option value="@s" selected="@(ViewBag.Status?.ToString() == s.ToString())">@s</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
    </div>
    <div class="col-md-1">
        <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
    </div>
</form>

<table class="table table-hover">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Client</th>
            <th>Service Level</th>
            <th>Status</th>
            <th>Start</th>
            <th>End</th>
            <th>Agreement</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            var badgeClass = c.Status switch {
                TechMove.Web.Models.ContractStatus.Active  => "bg-success",
                TechMove.Web.Models.ContractStatus.Expired => "bg-danger",
                TechMove.Web.Models.ContractStatus.OnHold  => "bg-warning text-dark",
                _                                          => "bg-secondary"
            };
            <tr>
                <td>@c.Title</td>
                <td>@c.Client?.Name</td>
                <td>@c.ServiceLevel</td>
                <td><span class="badge @badgeClass">@c.Status</span></td>
                <td>@c.StartDate.ToShortDateString()</td>
                <td>@c.EndDate.ToShortDateString()</td>
                <td>
                    @if (!string.IsNullOrEmpty(c.SignedAgreementPath))
                    {
                        <a href="@c.SignedAgreementPath" class="btn btn-sm btn-outline-success" download>Download</a>
                    }
                    else { <span class="text-muted">None</span> }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-info">View</a>
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
