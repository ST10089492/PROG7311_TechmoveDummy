@model TechMove.Web.Models.ServiceRequest
@{ ViewData["Title"] = "Delete Service Request"; }

<h2 class="text-danger">Delete Service Request</h2>
<p>Are you sure you want to delete this service request for <strong>@Model.Contract?.Title</strong>?</p>
<p><strong>Description:</strong> @Model.Description</p>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
