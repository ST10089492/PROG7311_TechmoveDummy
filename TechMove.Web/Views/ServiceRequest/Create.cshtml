@model TechMove.Web.Models.ServiceRequest
@{ ViewData["Title"] = "New Service Request"; }

<h2>New Service Request</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="ContractId" class="form-label">Contract</label>
                <select asp-for="ContractId" asp-items="ViewBag.Contracts" class="form-select">
                    <option value="">-- Select Contract --</option>
                </select>
                <div id="contract-status-warning" class="alert alert-warning mt-2 d-none" role="alert"></div>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CostUSD" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="CostUSD" type="number" step="0.01" min="0" class="form-control" />
                </div>
                <span asp-validation-for="CostUSD" class="text-danger"></span>
                <div class="form-text">ZAR equivalent will be calculated automatically on save.</div>
            </div>
            <button type="submit" class="btn btn-primary">Submit Request</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Client-side contract status warning warns before submission if contract is Expired or OnHold
        const contractStatuses = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(ViewBag.ContractStatuses ?? new Dictionary<int, string>())
        );

        const select = document.getElementById('ContractId');
        const warning = document.getElementById('contract-status-warning');

        function checkContractStatus() {
            const selectedId = parseInt(select.value);
            const status = contractStatuses[selectedId];
            if (status === 'Expired' || status === 'OnHold') {
                warning.textContent = `Warning: the selected contract is ${status}. This request will be rejected on submission.`;
                warning.classList.remove('d-none'); // Dynamically updates UI using JavaScript (Code, 2025)
            } else {
                warning.classList.add('d-none');
            }
        }

        select.addEventListener('change', checkContractStatus); // Event-driven programming improves interactivity (The IIE, 2026)
        checkContractStatus(); // run on page load for pre-selected contracts
    </script>
}
