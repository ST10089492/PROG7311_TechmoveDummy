@model TechMove.Web.Models.ServiceRequest
@inject TechMove.Web.ApiClients.TokenStore TokenStore
@{
    ViewData["Title"] = "Service Request Details";
    var statuses = new[] { "Pending", "InProgress", "Completed", "Cancelled" };
}

<h2>Service Request #@Model.Id</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Contract</dt>
    <dd class="col-sm-9">@Model.Contract?.Title</dd>
    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>
    <dt class="col-sm-3">Cost (USD)</dt>
    <dd class="col-sm-9">$@Model.CostUSD.ToString("N2")</dd>
    <dt class="col-sm-3">Cost (ZAR)</dt>
    <dd class="col-sm-9"><strong>R @Model.CostZAR.ToString("N2")</strong></dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
    <dt class="col-sm-3">Created On</dt>
    <dd class="col-sm-9">@Model.CreatedOn.ToString("f")</dd>
</dl>

@if (TokenStore.IsLoggedIn)
{
    <div class="card my-3">
        <div class="card-body">
            <h5 class="card-title">Change status</h5>
            <p class="text-muted small">Only the moves allowed by the workflow will be accepted.</p>
            <div class="d-flex gap-2 flex-wrap">
                @foreach (var s in statuses)
                {
                    @if (s != Model.Status)
                    {
                        <form asp-action="ChangeStatus" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="status" value="@s" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">@s</button>
                        </form>
                    }
                }
            </div>
        </div>
    </div>
}

<a asp-action="Index" class="btn btn-secondary">Back</a>
<a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
